{
  "rewrites": [
    { 
      "source": "/api/:path*", 
      "destination": "https://kabbolens-production.up.railway.app/api/:path*" 
    },
    { 
      "source": "/health", 
      "destination": "https://kabbolens-production.up.railway.app/health" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/$1" 
    }
  ]
}